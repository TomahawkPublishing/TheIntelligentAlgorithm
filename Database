import sqlite3
import pandas as pd

def fetch_company_summary(ric):
    """
    Connects to MasterData.db and performs a relational join to 
    retrieve a high-level summary of a specific entity.
    """
    try:
        # Connect to the local SQLite database
        conn = sqlite3.connect('MasterData.db')
        
        # SQL Query: Joining across the Registry, Fundamentals, Income, and Cash Flow tables
        # This ensures we get a 'Unified View' of the entity.
        query = """
        SELECT 
            r.Company_Name,
            f.PE_Ratio,
            i.Total_Revenue,
            c.CapEx
        FROM fact_fundamentals f
        JOIN fact_registry r ON f.RIC = r.RIC
        JOIN fact_income_statement i ON f.RIC = i.RIC
        JOIN fact_cash_flow c ON f.RIC = c.RIC
        WHERE r.RIC = ?
        ORDER BY i.Fiscal_Year DESC
        LIMIT 1;
        """
        
        # Use Pandas to read the query results for easy analysis
        df = pd.read_sql_query(query, conn, params=(ric,))
        
        conn.close()
        
        if not df.empty:
            return df
        else:
            print(f"No data found for RIC: {ric}")
            return None

    except sqlite3.Error as e:
        print(f"Database error: {e}")
        return None

